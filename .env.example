# Kopieren nach .env und Werte anpassen. Die Datei .env gehört NICHT ins Git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=bitte-aendern

APP_HOST=127.0.0.1
APP_PORT=8000
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Auf true setzen, um /health einen Fehler liefern zu lassen (Probe-Übungen)
FORCE_UNHEALTHY=false
